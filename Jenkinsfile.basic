pipeline {
    agent any
    tools {
        jdk 'JDK21'
        maven 'M3'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps { dir('sample-java-app') { sh 'mvn -B clean compile' } }
        }
        stage('Test') {
            steps { dir('sample-java-app') { sh 'mvn -B test' } }
            post {
                always { junit testResults: 'sample-java-app/target/surefire-reports/*.xml', allowEmptyResults: true }
            }
        }
        stage('Package') {
            steps {
                dir('sample-java-app') { sh 'mvn -B package -DskipTests' }
                archiveArtifacts artifacts: 'sample-java-app/target/*.jar', fingerprint: true
            }
        }
    }
}
